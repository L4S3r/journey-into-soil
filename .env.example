# Copy to .env (never commit .env)
DATABASE_URL=sqlite:////srv/data/app.db
KNOWLEDGE_DIR=/srv/knowledge
CONTRACTS_DIR=/srv/contracts
PACKS_DIR=/srv/data/packs
CORS_ORIGINS=http://localhost:5173

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173
AUTH_SECRET_KEY=journey-into-the-soil-secret-key-2026

# Cloudflare Tunnel token (for live HTTPS via Option 2)
CLOUDFLARE_TUNNEL_TOKEN=
# Earthdata (only needed on the laptop that runs pipelines/, never on the server)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
